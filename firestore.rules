rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
  
    // Helper Functions
    function isSignedIn() { 
      return request.auth != null; 
    }
    
    function isOwnerEmail() {
      return isSignedIn() && 
        request.auth.token.email != null && 
        request.auth.token.email.lower() == 'vmedin@gmail.com';
    }

    function hasStaffDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/cony_staff_users/$(request.auth.uid));
    }
    
    function getStaffRole() {
      return hasStaffDoc() ? get(/databases/$(database)/documents/cony_staff_users/$(request.auth.uid)).data.role : 'esperando';
    }
    
    function isSuperAdmin() { 
      return isOwnerEmail() || (isSignedIn() && getStaffRole() == 'superadmin'); 
    }

    function isAdmin() { 
      return isSuperAdmin() || (isSignedIn() && getStaffRole() == 'admin'); 
    }

    function isStaff() { 
      return isAdmin() || (isSignedIn() && (getStaffRole() == 'mensajero' || getStaffRole() == 'repartidor' || getStaffRole() == 'cocina')); 
    }

    // Health / connection test doc (SKILL requirement)
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Public configurations
    match /settings/cony_business_config {
      allow read, write: if true;
    }
    
    match /settings/cony_user_profiles_v3 {
      allow read, write: if true;
    }

    // Food items (Menu dishes)
    match /cony_food_items/{itemId} {
      allow read, write: if true;
    }

    // Orders - Customers can create; staff/superadmin and demo admin can manage
    match /cony_orders/{orderId} {
      allow read, write: if true;
    }

    // Expenses (Caja Chica)
    match /cony_expenses/{expenseId} {
      allow read, write: if true;
    }

    // Resto Clients (CRM)
    match /cony_resto_clients/{clientId} {
      allow read, write: if true;
    }

    // Coupons
    match /cony_coupons/{couponId} {
      allow read, write: if true;
    }

    // Staff Users (Roles and permissions management)
    match /cony_staff_users/{userId} {
      allow read, write: if true;
    }

    // Audit Logs
    match /cony_audit_logs/{logId} {
      allow read, write: if true;
    }
  }
}
